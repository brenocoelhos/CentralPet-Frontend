{
  "expo": {
    "name": "CentralPet",
    "slug": "centralpet-frontend",
    "owner": "soobinnie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "centralpetfrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.centralpet",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.138731032989-kf122ihlmu30m848rffbe3jb4j0hcumj"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.138731032989-kf122ihlmu30m848rffbe3jb4j0hcumj"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.138731032989-kf122ihlmu30m848rffbe3jb4j0hcumj"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.138731032989-kf122ihlmu30m848rffbe3jb4j0hcumj"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.centralpet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O CentralPet usa sua localização para alertar sobre pets perdidos perto de você.",
          "locationWhenInUsePermission": "O CentralPet usa sua localização para alertar sobre pets perdidos perto de você."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/35447767-63f3-49b6-8c66-f84978e40bc0"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35447767-63f3-49b6-8c66-f84978e40bc0"
      }
    }
  }
}
